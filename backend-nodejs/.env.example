# ---- Server ----
PORT=3000
# development: more detailed errors. production: use this on a deployed server
NODE_ENV=development

# ---- Database ----
MONGODB_URI=mongodb://localhost:27017/supermarket-checkout
# Only if Atlas fails with "querySrv ECONNREFUSED" on your machine:
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ---- Login (Google Sign-In, free) ----
JWT_SECRET=change_me_32_chars_min
# How long a sign-in lasts. 24h is a good balance; shoppers sign in again each day. "Sign out of all devices" is on the Account page.
JWT_EXPIRES_IN=24h
# Create one at https://console.cloud.google.com/apis/credentials -> Create credentials -> OAuth client ID -> Web application.
# Add http://localhost:5173 (and your deployed address) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Google email addresses (comma separated) that are admins. Everyone else is a customer; admins make staff on the Staff page.
ADMIN_EMAILS=you@gmail.com

# ---- Razorpay (use TEST keys while developing) ----
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
# From the webhook you create in the Razorpay dashboard:
# RAZORPAY_WEBHOOK_SECRET=xxx

# ---- Deployment ----
FRONTEND_URL=http://localhost:5173
# Your deployed frontend address(es), comma separated
# CORS_ORIGINS=https://your-frontend.vercel.app

# ---- Logging ----
LOG_LEVEL=INFO

# Requests allowed per IP address every 15 minutes (a shop's Wi-Fi shares one IP, so keep this generous)
# RATE_LIMIT_MAX=1000
