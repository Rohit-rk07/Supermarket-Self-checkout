# ---- Server ----
PORT=3000
# development: demo is on, and OTP codes print in this console when Twilio is not set up
# production: use this on a deployed server
NODE_ENV=development

# ---- Database ----
MONGODB_URI=mongodb://localhost:27017/supermarket-checkout
# Only if Atlas fails with "querySrv ECONNREFUSED" on your machine:
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ---- Login ----
JWT_SECRET=change_me_32_chars_min
JWT_EXPIRES_IN=7d
# Numbers (with country code) that become admin on first login. Only works while no admin exists.
# ADMIN_PHONE_NUMBERS=+919876543210

# ---- Razorpay (use TEST keys while developing) ----
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
# From the webhook you create in the Razorpay dashboard:
# RAZORPAY_WEBHOOK_SECRET=xxx

# ---- Twilio (real SMS). Leave empty in development to print codes in the console ----
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ---- Public demo on a deployed site (refused unless RAZORPAY_KEY_ID is a rzp_test_ key) ----
# ENABLE_PUBLIC_DEMO=true

# ---- Deployment ----
FRONTEND_URL=http://localhost:5173
# Your deployed frontend address(es), comma separated
# CORS_ORIGINS=https://your-frontend.vercel.app

# ---- Logging ----
LOG_LEVEL=INFO
